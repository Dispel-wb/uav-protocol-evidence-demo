{
  "name": "uav-protocol-evidence-demo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node tests/test_decoder.js && node tests/test_discovery.js && node tests/test_link_intelligence.js && node tests/test_stream_intelligence.js && node tests/test_state_analysis.js && node tests/test_protocol_model.js && node tests/test_model_evaluation.js && node tests/test_active_learning.js",
    "evaluate:model": "node scripts/evaluate_protocol_model.js",
    "test:rf": "python -m unittest discover -s tests -p test_rf_pipeline.py -v",
    "diagnose:sdr": "python -m rf.diagnose_sdr --output reports/hardware_readiness.json",
    "fixture:iq": "python -m rf.generate_iq_fixture",
    "analyze:iq": "python -m rf.analyze_iq samples/iq/fsk_demo.sigmf-meta --output reports/iq_quality_fsk_demo.json",
    "demod:iq": "python -m rf.demodulate_iq samples/iq/fsk_demo.sigmf-meta --symbol-rate 1200 --truth samples/iq/fsk_demo_truth.json --output reports/fsk_demod_report.json --hex-output reports/fsk_demo.demod.hex",
    "select:iq": "python -m rf.select_demod samples/iq/fsk_demo.sigmf-meta --symbol-rates 800 1000 1200 2400 --output reports/fsk_candidate_selection.json",
    "evaluate:fsk": "python scripts/evaluate_fsk_robustness.py",
    "evaluate:modulation": "python scripts/evaluate_modulation_shape.py",
    "evaluate:bpsk": "python scripts/evaluate_bpsk.py",
    "evaluate:qpsk": "python scripts/evaluate_qpsk.py",
    "evaluate:denoise": "python scripts/evaluate_impulse_denoise.py",
    "evaluate:tone-denoise": "python scripts/evaluate_tone_denoise.py",
    "evaluate:rrc": "python scripts/evaluate_rrc_psk.py",
    "evaluate:clock-drift": "python scripts/evaluate_clock_drift.py",
    "evaluate:gardner": "python scripts/evaluate_gardner_timing.py",
    "evaluate:multipath": "python scripts/evaluate_multipath_equalizer.py",
    "evaluate:carrier-drift": "python scripts/evaluate_carrier_drift.py",
    "stream:replay": "python -m rf.stream_replay samples/iq/fsk_demo.sigmf-meta --repeat 3 --output reports/streaming_pipeline.json",
    "stream:state": "python -m rf.stream_state_demo --output reports/streaming_state_trajectory.json",
    "test:e2e": "npm run fixture:iq && npm run analyze:iq && npm run demod:iq && node scripts/verify_demod_output.js reports/fsk_demo.demod.hex"
  }
}
